#!/command/with-contenv sh
# Hermes Agent — Dokku first-boot config seed.
# Runs as a s6 cont-init.d hook (BEFORE user services start).
#
# On first boot (empty /opt/data), this writes /opt/data/config.yaml with
# the LLM provider + API server settings derived from environment variables.
# On subsequent boots this is a no-op (config.yaml already exists).
#
# We deliberately use the YAML schema documented in upstream AGENTS.md
# (hermes_cli/config.py). Keys are kept minimal — only what the gateway
# needs to come up. Operators can extend the file later via
# `dokku run hermes-agent hermes config set <dotpath> <value>`.

set -e

HERMES_DATA="${HERMES_HOME:-/opt/data}"
CONFIG_FILE="$HERMES_DATA/config.yaml"

# Skip if config.yaml already exists (preserves operator changes).
if [ -s "$CONFIG_FILE" ]; then
    echo "[hermes-dokku-config] config.yaml already present, skipping seed"
    exit 0
fi

mkdir -p "$HERMES_DATA"

# Resolve values from env (Dokku config:set) with safe defaults.
LLM_BASE_URL="${LLM_BASE_URL:-http://100.73.253.25:20128/v1}"
LLM_API_KEY="${LLM_API_KEY:-${OMNIROUTE_API_KEY:-}}"
LLM_MODEL="${LLM_MODEL:-auto/best}"
API_SERVER_HOST="${API_SERVER_HOST:-0.0.0.0}"
API_SERVER_PORT="${API_SERVER_PORT:-9091}"
API_SERVER_KEY="${API_SERVER_KEY:-}"
TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN:-}"

# Build the platform blocks. Telegram is only enabled if a bot token is set.
TELEGRAM_BLOCK=""
if [ -n "$TELEGRAM_BOT_TOKEN" ]; then
    TELEGRAM_BLOCK="  telegram:
    enabled: true
    bot_token: \"\${TELEGRAM_BOT_TOKEN}\"
    allowed_users: []
"
fi

# Custom provider block (OmniRoute / any OpenAI-compatible endpoint).
# Per upstream providers/base.py: base_url is honored + fetch_models will
# hit {base_url}/models. CUSTOM_API_KEY / CUSTOM_BASE_URL are read at
# runtime from the process env (hermes_cli/runtime_provider.py:_getenv).
cat > "$CONFIG_FILE" <<YAML
# Hermes Agent — Dokku-generated config.
# Generated by /etc/cont-init.d/00-hermes-dokku-config on first boot.
# Edit freely; subsequent boots will NOT overwrite this file.

model:
  default: "${LLM_MODEL}"
  provider: "custom"
  base_url: "${LLM_BASE_URL}"
  api_key: "\${CUSTOM_API_KEY}"
  api_mode: "chat_completions"

agent:
  max_iterations: 500
  enabled_toolsets:
    - terminal
    - file
    - search
    - web
    - memory
    - skills
    - todo
    - delegation

display:
  skin: "default"

gateway:
  enabled: true
  api_server:
    enabled: true
    host: "${API_SERVER_HOST}"
    port: ${API_SERVER_PORT}
    key: "${API_SERVER_KEY}"
    cors_origins: ""

platforms:
${TELEGRAM_BLOCK}YAML

# Fix ownership (the file is created as root in cont-init.d; the hermes
# user owns it after chown). Idempotent on subsequent boots because we
# already exited above.
chown -R hermes:hermes "$HERMES_DATA" 2>/dev/null || true

echo "[hermes-dokku-config] seeded $CONFIG_FILE (provider=custom base_url=$LLM_BASE_URL model=$LLM_MODEL)"
