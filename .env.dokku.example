# Hermes Agent — Dokku environment schema
# Copy to Infisical / set via `dokku config:set` (values come from psst).

# === LLM provider (OmniRoute on agent-helper) ===
# OmniRoute is the LLM gateway on agent-helper at http://100.73.253.25:20128
# (Tailscale-only). It exposes an OpenAI-compatible /v1/chat/completions.
LLM_BASE_URL=http://100.73.253.25:20128/v1
LLM_API_KEY=                        # from psst OMNIROUTE_API_KEY
LLM_MODEL=auto/best                 # OmniRoute auto-routing combo
CUSTOM_API_KEY=                     # mirror of LLM_API_KEY (Hermes custom provider)
CUSTOM_BASE_URL=                    # mirror of LLM_BASE_URL (Hermes custom provider)

# === OpenAI-compatible API server (for OpenWebUI) ===
# The api_server platform inside Hermes. Dokku exposes $API_SERVER_PORT on
# the container; we default 9091 to leave 9090 free for the internal
# healthcheck. UFW on the GCP host blocks 9090/9091 from the public
# interface, so this is Tailscale-only.
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=9091
API_SERVER_KEY=                     # from psst HERMES_API_SERVER_KEY, 48+ chars random

# === Telegram gateway (optional) ===
TELEGRAM_BOT_TOKEN=                 # from psst TELEGRAM_BOT_TOKEN

# === User / runtime identity (no secrets) ===
HERMES_UID=10000
HERMES_GID=10000
HERMES_DISABLE_LAZY_INSTALLS=1
HERMES_LAZY_INSTALL_TARGET=/opt/data/lazy-packages

# === Storage ===
# Mounted via `dokku storage:mount hermes-agent \
#   /var/lib/dokku/data/storage/hermes-agent:/opt/data`
# This is the only durable state (config.yaml, auth.json, skills, memory,
# OAuth tokens, lazy-packages). Back this up.
