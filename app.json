{
  "name": "hermes-agent",
  "description": "Hermes Agent by Nous Research (CLI + Telegram gateway + OpenAI-compatible API server)",
  "keywords": ["ai", "agent", "hermes", "nous-research", "openai-compatible"],
  "website": "https://hermes-agent.nousresearch.com/",
  "repository": "https://github.com/Securiteru/hermes-agent",
  "healthchecks": {
    "web": [
      {
        "type": "startup",
        "path": "/health",
        "attempts": 10,
        "wait": 30,
        "timeout": 90,
        "content": "ok"
      },
      {
        "type": "uptime",
        "path": "/health",
        "attempts": 3,
        "wait": 5,
        "timeout": 30
      }
    ]
  }
}
